<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Block access to sensitive configuration, database, and system files
    RewriteRule ^\.env.*$ - [F,L,NC]
    RewriteRule ^\.(git|editorconfig).*$ - [F,L,NC]
    RewriteRule \.(sql|json|lock|xml|md|yml|yaml)$ - [F,L,NC]
    RewriteRule ^(artisan|Dockerfile|Procfile|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js)$ - [F,L,NC]

    # 2. Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(\/.*)?$ - [F,L,NC]
    RewriteRule ^storage\/(framework|logs)(\/.*)?$ - [F,L,NC]

    # 3. Handle Authorization Header for APIs & Auth
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 4. Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 5. Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 6. Route /storage requests directly to storage/app/public without symlink
    RewriteCond %{DOCUMENT_ROOT}/storage/app/public/$1 -f
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

    # 7. Fallback asset routing to public directory if not present in root
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 8. Send All Other Requests To Front Controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
